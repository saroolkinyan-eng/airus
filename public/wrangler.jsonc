{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "airus",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_LOGIN": "sarosaasa"
  }
}
